# Copy to lab.env; chmod 600. Never commit lab.env.
# Direct endpoints default to http://192.168.68.66:8096, :8097/emby, and :8098.
# SSH fallback: start LAB_PORT_BASE=18396 scripts/lab/tunnel.sh and run clients
# with LAB_HOST=127.0.0.1 LAB_PORT_BASE=18396.
JELLYFIN_OWNER_USER=labowner
JELLYFIN_OWNER_PASSWORD=change-this
JELLYFIN_ADULT_USER=adult
JELLYFIN_ADULT_PASSWORD=change-this
JELLYFIN_CHILD_USER=child
JELLYFIN_CHILD_PASSWORD=change-this
EMBY_OWNER_USER=labowner
EMBY_OWNER_PASSWORD=change-this
EMBY_ADULT_USER=adult
EMBY_ADULT_PASSWORD=change-this
EMBY_CHILD_USER=child
EMBY_CHILD_PASSWORD=change-this
SILO_SECRET_KEY=replace-with-openssl-rand-hex-32
SILO_OWNER_USER=labowner
SILO_OWNER_PASSWORD=change-this
SILO_ADULT_USER=adult
SILO_ADULT_PASSWORD=change-this
SILO_CHILD_USER=child
SILO_CHILD_PASSWORD=change-this
