            "hls"
          ],
          [
            "fastSeek",
            "1"
          ],
          [
            "directPlay",
            "1"
          ],
          [
            "directStream",
            "1"
          ],
          [
            "videoQuality",
            "8"
          ],
          [
            "X-Plex-Client-Profile-Extra",
            ""
          ]
        ],
        "headers": [
          [
            "Accept",
            "application/xml"
          ],
          [
            "X-Plex-Product",
            "Plex Web"
          ],
