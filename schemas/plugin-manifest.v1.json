{
  "$id": "https://ether.dev/schemas/plugin-manifest.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A Stremio add-on manifest plus the ether block. This schema mirrors the rules enforced by internal/plugins Manifest.Validate; the Go validator is authoritative.",
  "properties": {
    "background": {
      "type": "string"
    },
    "behaviorHints": true,
    "catalogs": {
      "items": {
        "properties": {
          "extra": true,
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "description": {
      "maxLength": 300,
      "type": "string"
    },
    "ether": {
      "properties": {
        "author": {
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "capabilities": {
          "items": {
            "enum": [
              "stream_source",
              "debrid_provider",
              "list_source",
              "metadata",
              "plugin_directory",
              "livetv_channels",
              "subtitles",
              "markers",
              "notify",
              "events",
              "ranking_step",
              "rule_condition",
              "tools",
              "ui",
              "onair_content",
              "livetv_pack",
              "catalog_provider",
              "kind_resolver",
              "frontend_adapter",
              "matcher"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "cluster": {
          "enum": [
            "leader",
            "every_node"
          ]
        },
        "contributes": {
          "description": "Per-capability metadata. Mandatory metadata is enforced by the Go validator.",
          "properties": {
            "channels": {
              "properties": {
                "refresh": {
                  "type": "string"
                },
                "test": {
                  "const": true
                }
              },
              "required": [
                "test"
              ],
              "type": "object"
            },
            "commands": {
              "items": {
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  },
                  "label": {
                    "maxLength": 40,
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "label",
                  "action"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "events": {
              "properties": {
                "subscribe": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "subscribe"
              ],
              "type": "object"
            },
            "frontendAdapters": {
              "items": {
                "properties": {
                  "auth": {
                    "type": "string"
                  },
                  "clients": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "defaultPort": {
                    "type": "integer"
                  },
                  "key": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "libraries": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "pathPrefix": {
                    "type": "string"
                  },
                  "protocolHint": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "integration": {
              "properties": {
                "adds": {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 4,
                  "minItems": 1,
                  "type": "array"
                },
                "category": {
                  "type": "string"
                },
                "connect": {
                  "enum": [
                    "fields",
                    "device_code",
                    "none"
                  ]
                },
                "logo": {
                  "type": "string"
                },
                "test": {
                  "type": "boolean"
                }
              },
              "required": [
                "category",
                "adds",
                "connect"
              ],
              "type": "object"
            },
            "listSources": {
              "items": {
                "properties": {
                  "catalog": {
                    "type": "string"
                  },
                  "hint": {
                    "maxLength": 120,
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  },
                  "label": {
                    "maxLength": 40,
                    "type": "string"
                  },
                  "maxItems": {
                    "maximum": 2000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "params": true,
                  "refresh": {
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "label",
                  "catalog"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "markers": {
              "properties": {
                "kinds": {
                  "items": {
                    "enum": [
                      "intro",
                      "credits",
                      "recap",
                      "preview"
                    ]
                  },
                  "type": "array"
                }
              },
              "required": [
                "kinds"
              ],
              "type": "object"
            },
            "mediaKinds": {
              "items": {
                "properties": {
                  "art": {
                    "items": {
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "role": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "browse": {
                    "properties": {
                      "facets": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "liveSearch": {
                        "type": "boolean"
                      },
                      "search": {
                        "type": "boolean"
                      },
                      "searchFields": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "sorts": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "type": "object"
                  },
                  "cache": {
                    "description": "Plugin-owned blob cache. http.fetchToCache streams a GET here under the existing network grant and library quota (at most 256 MiB per fetch). cache.read and archive.list/open use only this plugin-owned blob namespace, with 1 MiB range results. ZIP supports Store/Deflate only; ZIP64, split and encrypted archives are refused.",
                    "properties": {
                      "maxBytes": {
                        "type": "integer"
                      },
                      "ttl": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "fields": {
                    "items": {
                      "properties": {
                        "enum": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "indexed": {
                          "type": "boolean"
                        },
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "type": {
                          "enum": [
                            "string",
                            "int",
                            "float",
                            "bool",
                            "date",
                            "duration",
                            "enum",
                            "strings",
                            "people"
                          ]
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "key": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "levels": {
                    "items": {
                      "properties": {
                        "container": {
                          "type": "boolean"
                        },
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "playable": {
                          "type": "boolean"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "library": {
                    "properties": {
                      "icon": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "match": {
                    "properties": {
                      "thresholdDefault": {
                        "type": "number"
                      }
                    },
                    "type": "object"
                  },
                  "present": {
                    "properties": {
                      "adapterOnly": {
                        "type": "boolean"
                      },
                      "mediaBrowser": {
                        "properties": {
                          "collectionType": {
                            "type": "string"
                          },
                          "itemTypes": {
                            "additionalProperties": {
                              "type": "string"
                            },
                            "type": "object"
                          }
                        },
                        "type": "object"
                      },
                      "plex": {
                        "properties": {
                          "base": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "silo": {
                        "properties": {
                          "type": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "stremio": {
                        "properties": {
                          "type": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "xtream": {
                        "properties": {
                          "category": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "sync": {
                    "properties": {
                      "mode": {
                        "type": "string"
                      },
                      "refresh": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "notification": {
              "properties": {
                "fields": true,
                "formats": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "maxLength": {
                  "minimum": 0,
                  "type": "integer"
                },
                "sendTest": {
                  "const": true
                }
              },
              "required": [
                "sendTest"
              ],
              "type": "object"
            },
            "onairFeeds": {
              "items": {
                "properties": {
                  "fields": {
                    "additionalProperties": {
                      "enum": [
                        "text",
                        "number",
                        "image",
                        "list"
                      ]
                    },
                    "type": "object"
                  },
                  "id": {
                    "type": "string"
                  },
                  "maxAge": {
                    "type": "string"
                  },
                  "sample": {
                    "type": "object"
                  }
                },
                "required": [
                  "id",
                  "fields",
                  "maxAge"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "onairSegments": {
              "items": {
                "properties": {
                  "duration": {
                    "maximum": 600,
                    "minimum": 4,
                    "multipleOf": 4,
                    "type": "integer"
                  },
                  "feeds": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "file": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "rating": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "duration",
                  "file",
                  "feeds"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "pages": {
              "items": {
                "properties": {
                  "group": {
                    "type": "string"
                  },
                  "icon": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  },
                  "label": {
                    "maxLength": 40,
                    "type": "string"
                  },
                  "route": {
                    "pattern": "^/",
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "label",
                  "route"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "rankingSteps": {
              "items": {
                "properties": {
                  "budget": true,
                  "editor": true,
                  "hint": {
                    "maxLength": 120,
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  },
                  "label": {
                    "maxLength": 40,
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "label"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "ruleConditions": {
              "items": {
                "properties": {
                  "editor": true,
                  "key": {
                    "type": "string"
                  },
                  "label": {
                    "maxLength": 40,
                    "type": "string"
                  },
                  "operators": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "key",
                  "label"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "slots": {
              "items": {
                "allOf": [
                  {
                    "else": {
                      "not": {
                        "required": [
                          "action"
                        ]
                      },
                      "required": [
                        "route"
                      ]
                    },
                    "if": {
                      "properties": {
                        "slot": {
                          "pattern": "^actionMenu\\."
                        }
                      },
                      "required": [
                        "slot"
                      ]
                    },
                    "then": {
                      "not": {
                        "required": [
                          "route"
                        ]
                      },
                      "required": [
                        "action"
                      ]
                    }
                  }
                ],
                "properties": {
                  "action": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  },
                  "label": {
                    "maxLength": 40,
                    "type": "string"
                  },
                  "route": {
                    "pattern": "^/",
                    "type": "string"
                  },
                  "slot": {
                    "type": "string"
                  }
                },
                "required": [
                  "slot",
                  "key",
                  "label"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "source": {
              "properties": {
                "abilities": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "class": {
                  "enum": [
                    "debrid",
                    "usenet",
                    "indexer",
                    "direct"
                  ]
                },
                "limits": true
              },
              "required": [
                "class"
              ],
              "type": "object"
            },
            "subtitles": {
              "properties": {
                "formats": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "languages": true
              },
              "type": "object"
            },
            "tools": {
              "items": {
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "destructive": {
                    "type": "boolean"
                  },
                  "inputSchema": {
                    "type": "object"
                  },
                  "name": {
                    "pattern": "^[a-z][a-z0-9_]{1,63}$",
                    "type": "string"
                  },
                  "openWorld": {
                    "type": "boolean"
                  },
                  "readOnly": {
                    "type": "boolean"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "title",
                  "description",
                  "inputSchema"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "health": {
          "properties": {
            "interval": {
              "description": "Go duration, at least 15s.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "icon": {
          "description": "SVG path or URL.",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source",
            "integration",
            "notification_channel",
            "livetv_source",
            "extension",
            "content"
          ]
        },
        "license": {
          "type": "string"
        },
        "permissions": {
          "properties": {
            "catalog": {
              "enum": [
                "none",
                "read"
              ]
            },
            "collections": {
              "enum": [
                "none",
                "write"
              ]
            },
            "folders": {
              "enum": [
                "none",
                "read"
              ]
            },
            "network": {
              "items": {
                "pattern": "^(\\*\\.)?([a-z0-9-]+\\.)*[a-z0-9-]+$",
                "type": "string"
              },
              "type": "array"
            },
            "secrets": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "viewers": {
              "properties": {
                "identity": {
                  "enum": [
                    "none",
                    "granted_viewers",
                    "all"
                  ]
                },
                "watch_history": {
                  "enum": [
                    "none",
                    "granted_viewers",
                    "all"
                  ]
                },
                "write_watch_state": {
                  "enum": [
                    "none",
                    "granted_viewers"
                  ]
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "protocol": {
          "const": 1
        },
        "repo": {
          "type": "string"
        },
        "runtime": {
          "properties": {
            "entry": {
              "description": "Compiled JS file. Hosted only.",
              "type": "string"
            },
            "kind": {
              "enum": [
                "hosted",
                "remote"
              ]
            },
            "module": {
              "description": "WASM file. Hosted only.",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "schedule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "properties": {
                  "call": {
                    "pattern": "^/",
                    "type": "string"
                  },
                  "every": {
                    "description": "Go duration, at least 15m.",
                    "type": "string"
                  }
                },
                "required": [
                  "every",
                  "call"
                ],
                "type": "object"
              },
              "type": "array"
            }
          ]
        },
        "settings": {
          "description": "Settings schema, {} or {\"$ref\":\"file\"}."
        },
        "strings": {
          "description": "Locale to file path or inline key map. en is required when $t: keys are used.",
          "type": "object"
        },
        "summary": {
          "description": "Plain text or a $t: key. Sentence case, no em dashes.",
          "maxLength": 80,
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "kind",
        "runtime"
      ],
      "type": "object"
    },
    "id": {
      "description": "Reverse-DNS, lower case, unique, never reused.",
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(\\.[a-z0-9][a-z0-9-]*)+$",
      "type": "string"
    },
    "idPrefixes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "logo": {
      "type": "string"
    },
    "name": {
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
    },
    "resources": true,
    "types": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "version": {
      "description": "SemVer. Updates must increase it.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-.+][0-9A-Za-z.-]*)?$",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "name"
  ],
  "title": "Ether plugin manifest (EPP/1)",
  "type": "object"
}
