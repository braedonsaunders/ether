<?xml version="1.0" encoding="utf-8"?>
<MPD xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="urn:mpeg:dash:schema:mpd:2011"
	xmlns:xlink="http://www.w3.org/1999/xlink"
	xsi:schemaLocation="urn:mpeg:dash:schema:mpd:2011 http://standards.iso.org/ittf/PubliclyAvailableStandards/MPEG-DASH_schema_files/DASH-MPD.xsd"
	profiles="urn:mpeg:dash:profile:isoff-live:2011"
	type="static"
	mediaPresentationDuration="PT2H3M4S"
	maxSegmentDuration="PT5S"
	minBufferTime="PT2.5S">
	<Period start="PT0S" id="0" duration="PT2H3M4S">
		<AdaptationSet segmentAlignment="true">
			<SegmentTemplate timescale="1000" duration="2500" initialization="s/a&amp;b/$RepresentationID$/init" media="s/a&amp;b/$RepresentationID$/$Number$.m4s" startNumber="0">
			</SegmentTemplate>
			<Representation id="0" mimeType="audio/mp4" codecs="mp4a.40.2" bandwidth="192000" audioSamplingRate="44100">
				<AudioChannelConfiguration schemeIdUri="urn:mpeg:dash:23003:3:audio_channel_configuration:2011" value="6"/>
			</Representation>
		</AdaptationSet>
	</Period>
</MPD>
