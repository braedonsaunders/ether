{
  "protocol": "silo",
  "client": "Silo Apple",
  "source": {
    "repo": "Silo-Server/silo-server",
    "commit": "44a345dbfb8c0a5892dc366ee0dd33fc091b7cf2",
    "files": [
      "contracts/api/v2/openapi.json",
      "contracts/api/v2/route-inventory.json"
    ]
  },
  "headers": {
    "Accept": "application/json",
    "Content-Type": "application/json",
    "Authorization": "Bearer ${access_token}",
    "X-Silo-Client": "Silo Apple",
    "X-Silo-Client-Version": "${app_version}",
    "X-Silo-Client-Build": "${app_build}"
  },
  "authorization": {
    "format": "Bearer access token returned from POST /api/v2/auth/login",
    "example": "Authorization: Bearer ${access_token}"
  },
  "flows": {
    "connect": [
      {
        "name": "server identity",
        "method": "GET",
        "path": "/api/v2/system/info"
      }
    ],
    "sign_in": [
      {
        "name": "native password login",
        "method": "POST",
        "path": "/api/v2/auth/login",
        "body": {
          "username": "${username}",
          "password": "${password}"
        }
      }
    ],
    "home": [
      {
        "name": "home sections",
        "method": "GET",
        "path": "/api/v2/home/sections",
        "headers": {
          "X-Profile-Id": "${profile_id}"
        }
      }
    ],
    "library_browse": [
      {
        "name": "user libraries",
        "method": "GET",
        "path": "/api/v2/user/libraries",
        "headers": {
          "X-Profile-Id": "${profile_id}"
        }
      },
      {
        "name": "library sections",
        "method": "GET",
        "path": "/api/v2/library/${library_id}/sections",
        "headers": {
          "X-Profile-Id": "${profile_id}"
        }
      }
    ],
    "item_detail": [
      {
        "name": "catalog item",
        "method": "GET",
        "path": "/api/v2/catalog/items/${item_id}",
        "headers": {
          "X-Profile-Id": "${profile_id}"
        }
      }
    ],
    "play_direct": [
      {
        "name": "direct playback plan",
        "method": "POST",
        "path": "/api/v2/playback/start",
        "body": {
          "installation_id": "${installation_id}",
          "protocol_version": 3,
          "client_features": [
            "playback_plan_v3"
          ],
          "file_id": "${file_id}",
          "profile_id": "${profile_id}",
          "playback_attempt_id": "${playback_attempt_id_direct}",
          "quality_preference": "${quality_preference}",
          "subtitle_fidelity_preference": "compatible",
          "client_capabilities": {
            "video_evidence": "exact",
            "audio_evidence": "exact",
            "codecs_video": [
              "h264"
            ],
            "codecs_video_hardware": [
              "h264"
            ],
            "codecs_audio": [
              "mp3",
              "aac"
            ],
            "containers": [
              "mp4"
            ],
            "hdr": false,
            "max_resolution": "1080p",
            "video_decode": [
              {
                "codec": "h264",
                "profiles": [
                  "high"
                ],
                "levels": [
                  41
                ],
                "bit_depths": [
                  8
                ],
                "max_width": 1920,
                "max_height": 1080,
                "max_frame_rate": 60,
                "max_bitrate_kbps": 20000,
                "hardware": true
              }
            ]
          },
          "client_playback_context": {
            "protocol_version": 3,
            "form_factor": "phone",
            "app_version": "${app_version}",
            "app_build": "${app_build}",
            "device": {},
            "output": {},
            "deliveries": {
              "original_http": {
                "enabled": true,
                "supported_on_device": true,
                "containers": [
                  "mp4"
                ],
                "video_codecs": [
                  "h264"
                ],
                "audio_decode_codecs": [
                  "mp3",
                  "aac"
                ],
                "audio_passthrough_codecs": [],
                "subtitles": {
                  "embedded_text": true,
                  "sidecar_text": true,
                  "ass_styling": false,
                  "embedded_bitmap": false,
                  "sidecar_bitmap": false,
                  "font_attachments": false
                },
                "features": [],
                "auth_header_refresh": true,
                "validated_claims": [],
                "transformations": []
              }
            }
          }
        },
        "headers": {
          "X-Profile-Id": "${profile_id}"
        }
      }
    ],
    "play_transcode": [
      {
        "name": "transcode playback plan",
        "method": "POST",
        "path": "/api/v2/playback/start",
        "body": {
          "installation_id": "${installation_id}",
          "protocol_version": 3,
          "client_features": [
            "playback_plan_v3"
          ],
          "file_id": "${file_id}",
          "profile_id": "${profile_id}",
          "playback_attempt_id": "${playback_attempt_id_transcode}",
          "quality_preference": "1080p",
          "subtitle_fidelity_preference": "compatible",
          "client_capabilities": {
            "video_evidence": "exact",
            "audio_evidence": "exact",
            "codecs_video": [
              "h264"
            ],
            "codecs_video_hardware": [
              "h264"
            ],
            "codecs_audio": [
              "mp3",
              "aac"
            ],
            "containers": [
              "mp4"
            ],
            "hdr": false,
            "max_resolution": "1080p",
            "video_decode": [
              {
                "codec": "h264",
                "profiles": [
                  "high"
                ],
                "levels": [
                  41
                ],
                "bit_depths": [
                  8
                ],
                "max_width": 1920,
                "max_height": 1080,
                "max_frame_rate": 60,
                "max_bitrate_kbps": 20000,
                "hardware": true
              }
            ]
          },
          "client_playback_context": {
            "protocol_version": 3,
            "form_factor": "phone",
            "app_version": "${app_version}",
            "app_build": "${app_build}",
            "device": {},
            "output": {},
            "deliveries": {
              "hls": {
                "enabled": true,
                "supported_on_device": true,
                "containers": [
                  "mp4"
                ],
                "video_codecs": [
                  "h264"
                ],
                "audio_decode_codecs": [
                  "mp3",
                  "aac"
                ],
                "audio_passthrough_codecs": [],
                "subtitles": {
                  "embedded_text": true,
                  "sidecar_text": true,
                  "ass_styling": false,
                  "embedded_bitmap": false,
                  "sidecar_bitmap": false,
                  "font_attachments": false
                },
                "features": [],
                "auth_header_refresh": true,
                "validated_claims": [],
                "transformations": []
              }
            }
          }
        },
        "headers": {
          "X-Profile-Id": "${profile_id}"
        }
      }
    ],
    "progress_reporting": [
      {
        "name": "playback progress",
        "method": "POST",
        "path": "/api/v2/playback/${play_session_id}/progress",
        "body": {
          "installation_id": "${installation_id}",
          "sequence": 1,
          "position": 60,
          "is_paused": false
        },
        "headers": {
          "X-Profile-Id": "${profile_id}"
        }
      }
    ],
    "mark_watched": [
      {
        "name": "report completion",
        "method": "POST",
        "path": "/api/v2/playback/${play_session_id}/progress",
        "body": {
          "installation_id": "${installation_id}",
          "sequence": 2,
          "position": 634,
          "is_paused": false
        },
        "headers": {
          "X-Profile-Id": "${profile_id}"
        }
      }
    ],
    "stop": [
      {
        "name": "stop session",
        "method": "DELETE",
        "path": "/api/v2/playback/${play_session_id}",
        "body": {
          "installation_id": "${installation_id}",
          "stop_id": "${stop_id}",
          "is_paused": false,
          "position": 634,
          "sequence": 3
        },
        "headers": {
          "X-Profile-Id": "${profile_id}"
        }
      }
    ]
  },
  "profile_status": "source-derived template; v2 routes and request bodies checked against build-1810 OpenAPI; live direct plan is playable; server returns adaptation_unavailable for transcode with current lab capabilities; progress and stop lifecycle tested"
}
