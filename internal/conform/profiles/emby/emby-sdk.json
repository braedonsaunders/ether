{
  "protocol": "emby",
  "client": "Emby.SDK v2 reference client",
  "source": {
    "repo": "MediaBrowser/Emby.SDK",
    "commit": "45e73012eddf985dcfe878ca031b500085e16496",
    "files": [
      "Resources/OpenApi/openapi_v2.json"
    ]
  },
  "headers": {
    "X-Emby-Authorization": "MediaBrowser Client=\"Emby.SDK v2 reference client\", Device=\"Unknown\", DeviceId=\"${device_id}\", Version=\"4.10\"",
    "X-Emby-Token": "${access_token}",
    "Accept": "application/json",
    "Content-Type": "application/json"
  },
  "authorization": {
    "format": "MediaBrowser auth parameters; authenticate then use access token",
    "example": "Authorization: MediaBrowser Client=\"Emby.SDK v2 reference client\", Device=\"Unknown\", DeviceId=\"${device_id}\", Version=\"4.10\", Token=\"${access_token}\""
  },
  "flows": {
    "connect": [
      {
        "name": "system info",
        "method": "GET",
        "path": "/System/Info/Public"
      },
      {
        "name": "public users",
        "method": "GET",
        "path": "/Users/Public"
      }
    ],
    "sign_in": [
      {
        "name": "authenticate",
        "method": "POST",
        "path": "/Users/AuthenticateByName",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "Username": "${username}",
          "Pw": "${password}"
        }
      }
    ],
    "home": [
      {
        "name": "views",
        "method": "GET",
        "path": "/Users/${user_id}/Views"
      },
      {
        "name": "resume",
        "method": "GET",
        "path": "/Users/${user_id}/Items/Resume"
      },
      {
        "name": "next up",
        "method": "GET",
        "path": "/Shows/NextUp?UserId=${user_id}"
      }
    ],
    "library_browse": [
      {
        "name": "items",
        "method": "GET",
        "path": "/Users/${user_id}/Items?ParentId=${parent_id}"
      }
    ],
    "item_detail": [
      {
        "name": "item",
        "method": "GET",
        "path": "/Users/${user_id}/Items/${item_id}"
      }
    ],
    "play_direct": [
      {
        "name": "playback info",
        "method": "POST",
        "path": "/Items/${item_id}/PlaybackInfo",
        "body": {
          "UserId": "${user_id}",
          "IsPlayback": true,
          "AutoOpenLiveStream": true,
          "StartTimeTicks": 0
        }
      },
      {
        "name": "direct stream",
        "method": "GET",
        "path": "/Videos/${item_id}/stream?Static=true"
      }
    ],
    "play_transcode": [
      {
        "name": "playback info",
        "method": "POST",
        "path": "/Items/${item_id}/PlaybackInfo",
        "body": {
          "UserId": "${user_id}",
          "IsPlayback": true,
          "AutoOpenLiveStream": true,
          "StartTimeTicks": 0
        }
      },
      {
        "name": "HLS playlist",
        "method": "GET",
        "path": "/Videos/${item_id}/master.m3u8?DeviceId=${device_id}"
      }
    ],
    "progress_reporting": [
      {
        "name": "playing",
        "method": "POST",
        "path": "/Sessions/Playing",
        "body": {
          "ItemId": "${item_id}",
          "PositionTicks": "${position_ticks}",
          "PlaySessionId": "${play_session_id}",
          "CanSeek": true
        }
      },
      {
        "name": "progress",
        "method": "POST",
        "path": "/Sessions/Playing/Progress",
        "body": {
          "ItemId": "${item_id}",
          "PositionTicks": "${position_ticks}",
          "PlaySessionId": "${play_session_id}",
          "CanSeek": true
        }
      }
    ],
    "mark_watched": [
      {
        "name": "played",
        "method": "POST",
        "path": "/Users/${user_id}/PlayedItems/${item_id}",
        "body": {}
      }
    ],
    "stop": [
      {
        "name": "stopped",
        "method": "POST",
        "path": "/Sessions/Playing/Stopped",
        "body": {
          "ItemId": "${item_id}",
          "PositionTicks": "${position_ticks}",
          "PlaySessionId": "${play_session_id}",
          "CanSeek": true
        }
      }
    ]
  },
  "profile_status": "source-derived-template; not captured traffic"
}
