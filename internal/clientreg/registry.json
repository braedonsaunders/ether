  "definitions": [
    {
      "id": "class-media-apps-tv",
      "role": "class",
      "class": "tv",
      "notes": "Cross-device Jellyfin apps on a TV box: Swiftfin tvOS, Infuse on Apple TV, Findroid or Streamyfin on Android TV and Shield.",
      "match": {"all": [
        {"any": [{"field": "product", "op": "contains", "value": "swiftfin"}, {"field": "product", "op": "contains", "value": "infuse"}, {"field": "product", "op": "contains", "value": "findroid"}, {"field": "product", "op": "contains", "value": "streamyfin"}]},
        {"any": [{"field": "identity", "op": "contains", "value": "tvos"}, {"field": "identity", "op": "contains", "value": "apple tv"}, {"field": "identity", "op": "contains", "value": "appletv"}, {"field": "identity", "op": "contains", "value": "android tv"}, {"field": "identity", "op": "contains", "value": "google tv"}, {"field": "identity", "op": "contains", "value": "shield"}]}
      ]}
    },
    {
      "id": "class-apple-apps-mobile",
      "role": "class",
      "class": "mobile",
      "notes": "Swiftfin and Infuse on an iPhone or iPad.",
      "match": {"all": [
        {"any": [{"field": "product", "op": "contains", "value": "swiftfin"}, {"field": "product", "op": "contains", "value": "infuse"}]},
        {"any": [{"field": "identity", "op": "contains", "value": "ios"}, {"field": "identity", "op": "contains", "value": "ipados"}, {"field": "identity", "op": "contains", "value": "iphone"}, {"field": "identity", "op": "contains", "value": "ipad"}]}
      ]}
    },
    {
      "id": "class-infuse-mac",
      "role": "class",
      "class": "computer",
      "notes": "Infuse on a Mac.",
      "match": {"all": [
        {"field": "product", "op": "contains", "value": "infuse"},
        {"any": [{"field": "identity", "op": "contains", "value": "macos"}, {"field": "identity", "op": "contains", "value": "mac os"}]}
      ]}
    },
    {
      "id": "class-jellyfin-mobile",
      "role": "class",
      "class": "mobile",
      "notes": "Jellyfin phone apps that report no platform: Findroid and Streamyfin. The official Jellyfin Android and iOS apps are placed by the playback records.",
      "match": {"any": [
        {"field": "product", "op": "contains", "value": "findroid"},
        {"field": "product", "op": "contains", "value": "streamyfin"}
      ]}
    },
    {
      "id": "class-kodi",
      "role": "class",
      "class": "computer",
      "notes": "Kodi add-ons (Plex for Kodi, JellyCon) group with Kodi and home theater PCs.",
      "match": {"any": [
        {"field": "product", "op": "contains", "value": "pm4k"},
        {"field": "product", "op": "contains", "value": "plex for kodi"},
        {"field": "product", "op": "contains", "value": "jellycon"},
        {"field": "product", "op": "contains", "value": "kodi"}
      ]}
    },
    {
      "id": "class-emby-tv",
      "role": "class",
      "class": "tv",
      "notes": "Emby's TV apps.",
      "match": {"any": [
        {"field": "product", "op": "contains", "value": "emby for tv"},
        {"field": "product", "op": "contains", "value": "emby for android tv"}
      ]}
    },
    {
      "id": "class-emby-web",
      "role": "class",
      "class": "computer",
      "notes": "Emby in a browser.",
      "match": {"field": "product", "op": "contains", "value": "emby web"}
    },
    {
      "id": "stremio-native-desktop",
      "role": "policy",
      "class": "computer",
      "family": "Stremio desktop (mpv)",
      "preset": "image",
      "notes": "Stremio's desktop shell plays through mpv, which renders HDR and Dolby Vision itself and tone-maps for an SDR display. Profile 7 plays its HDR10 base.",
      "dolbyVisionProfiles": [5, 8],
      "match": {"all": [
        {"field": "product", "op": "equals", "value": "stremio"},
        {"field": "platform", "op": "equals", "value": "desktop"}
      ]}
    },
    {
      "id": "stremio-native-android",
      "role": "policy",
      "class": "mobile",
      "family": "Stremio native player (Android)",
      "preset": "image",
      "notes": "Stremio Android, Android TV and Nuvio play through ExoPlayer, libVLC or libmpv. Dolby Vision depends on the device decoder, which Ether cannot see, so it is off by default; profile 7 and 8.1 play their HDR10 base.",
      "dolbyVisionProfiles": [8],
      "match": {"all": [
        {"any": [
          {"field": "product", "op": "equals", "value": "stremio"},
          {"field": "product", "op": "equals", "value": "nuvio"}
        ]},
        {"field": "platform", "op": "equals", "value": "android"}
      ]}
    },
    {
      "id": "nuvio-ios",
      "role": "policy",
      "class": "mobile",
      "family": "Nuvio (iOS)",
      "preset": "text",
      "notes": "Nuvio on iOS plays HDR10 natively; Dolby Vision stays off by default.",
      "dolbyVisionProfiles": [8],
      "match": {"all": [
        {"field": "product", "op": "equals", "value": "nuvio"},
        {"field": "platform", "op": "equals", "value": "ios"}
      ]}
    },
    {
      "id": "pm4k",
      "role": "policy",
      "class": "tv",
      "family": "Kodi",
      "preset": "image",
      "dolbyVisionProfiles": [5, 7, 8],
      "match": {"any": [
        {"field": "product", "op": "equals", "value": "pm4k"},
        {"field": "product", "op": "equals", "value": "plex for kodi"}
      ]}
    },
    {
      "id": "apple-tv-hd",
      "role": "policy",
      "class": "tv",
      "family": "Apple TV",
      "preset": "text",
      "notes": "Apple TV HD (AppleTV5,3, A8): 1080p SDR. No HDR10 or Dolby Vision; 4K and HDR sources are transcoded.",
      "dolbyVisionProfiles": [],
      "match": {
        "all": [
          {
            "any": [
              {"field": "identity", "op": "contains", "value": "apple tv"},
              {"field": "identity", "op": "contains", "value": "appletv"},
              {"field": "identity", "op": "contains", "value": "tvos"}
            ]
          },
          {"field": "model", "op": "prefix", "value": "AppleTV5,"}
        ]
      }
    },
    {
      "id": "apple-tv",
      "role": "policy",
      "class": "tv",
      "family": "Apple TV",
      "preset": "text",
      "notes": "Dolby Vision profile 7 uses a compatible HDR base layer; TrueHD requires an audio transcode unless declared supported.",
      "dolbyVisionProfiles": [5, 8],
      "match": {
        "any": [
          {"field": "identity", "op": "contains", "value": "apple tv"},
          {"field": "identity", "op": "contains", "value": "appletv"},
          {"field": "identity", "op": "contains", "value": "tvos"}
