        "any": [
          {"field": "identity", "op": "contains", "value": "android"},
          {"field": "identity", "op": "contains", "value": "google tv"}
        ]
      }
    },
    {
      "id": "fire-tv",
      "role": "policy",
      "family": "Fire TV",
      "preset": "text",
      "match": {"field": "identity", "op": "contains", "value": "fire tv"}
