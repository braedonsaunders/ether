{
  "version": 1,
  "presets": {
    "text": {
      "subtitles": ["srt", "subrip", "webvtt", "vtt", "ass", "ssa"],
      "notes": "Text is served separately; image subtitles require explicit client support."
    },
    "image": {
      "subtitles": ["srt", "subrip", "webvtt", "vtt", "ass", "ssa", "pgs", "hdmv_pgs_subtitle", "vobsub", "dvd_subtitle"],
      "notes": "Text is served separately; image subtitles require explicit client support."
    },
    "apple": {
      "video": ["h264", "hevc"],
      "audio": ["aac", "ac3", "eac3", "mp3", "flac", "alac", "opus"],
      "containers": ["mp4", "mov", "mkv", "mpegts"],
      "maxHeight": 2160,
      "hdr10": true,
      "dolbyVision": true
    },
    "android": {
      "video": ["h264", "hevc", "vp9"],
      "audio": ["aac", "ac3", "eac3", "mp3", "flac", "opus", "vorbis"],
      "containers": ["mp4", "mkv", "mpegts", "webm"],
      "maxHeight": 1080
    },
    "androidTV": {
      "video": ["h264", "hevc", "vp9", "av1"],
      "audio": ["aac", "ac3", "eac3", "mp3", "flac", "opus", "vorbis"],
      "containers": ["mp4", "mkv", "mpegts", "webm"],
      "maxHeight": 2160,
      "hdr10": true
    },
    "roku": {
      "video": ["h264", "hevc"],
      "audio": ["aac", "ac3", "eac3", "mp3", "flac"],
      "containers": ["mp4", "mkv", "mpegts"],
      "maxHeight": 2160,
      "hdr10": true
    },
    "smartTV": {
      "video": ["h264", "hevc"],
      "audio": ["aac", "ac3", "eac3", "mp3"],
      "containers": ["mp4", "mkv", "mpegts"],
      "maxHeight": 2160,
      "hdr10": true
    },
    "htpc": {
      "video": ["h264", "hevc", "vp9", "av1", "mpeg2video", "vc1", "mpeg4"],
      "audio": ["aac", "ac3", "eac3", "truehd", "dts", "dtshd", "mp3", "flac", "opus", "vorbis", "pcm"],
      "containers": ["mp4", "mkv", "mov", "avi", "mpegts", "webm"],
      "maxHeight": 2160,
      "hdr10": true
    },
    "generic": {
      "video": ["h264"],
      "audio": ["aac", "mp3"],
      "containers": ["mp4", "mpegts"],
      "maxHeight": 1080
    },
    "browser": {
      "video": ["h264"],
      "audio": ["aac", "mp3", "opus", "flac", "vorbis"],
      "containers": ["mp4", "mkv", "webm", "mpegts"],
      "maxHeight": 2160
    },
    "browserSafari": {
      "video": ["h264", "hevc"],
      "audio": ["aac", "mp3", "ac3", "eac3", "flac", "alac"],
      "containers": ["mp4", "mov", "mpegts"],
      "maxHeight": 2160,
      "hdr10": true
    },
    "browserEdge": {
      "video": ["h264", "hevc", "vp9", "av1"],
      "audio": ["aac", "mp3", "opus", "flac", "vorbis", "ac3", "eac3"],
      "containers": ["mp4", "mkv", "webm", "mpegts"],
      "maxHeight": 2160
    },
    "browserChrome": {
      "video": ["h264", "vp9", "av1", "hevc"],
      "audio": ["aac", "mp3", "opus", "flac", "vorbis"],
      "containers": ["mp4", "mkv", "webm", "mpegts"],
      "maxHeight": 2160
    },
    "browserFirefox": {
      "video": ["h264", "vp9", "av1"],
      "audio": ["aac", "mp3", "opus", "flac", "vorbis"],
      "containers": ["mp4", "mkv", "webm", "mpegts"],
      "maxHeight": 2160
    }
  },
  "definitions": [
    {
      "id": "apple-tv",
      "role": "policy",
      "family": "Apple TV",
      "preset": "text",
      "notes": "Dolby Vision profile 7 uses a compatible HDR base layer; TrueHD requires an audio transcode unless declared supported.",
      "dolbyVisionProfiles": [5, 8],
      "match": {
        "any": [
          {"field": "identity", "op": "contains", "value": "apple tv"},
          {"field": "identity", "op": "contains", "value": "tvos"}
        ]
      }
    },
    {
      "id": "ios",
      "role": "policy",
      "family": "iOS",
      "preset": "text",
      "dolbyVisionProfiles": [5, 8],
      "match": {
        "any": [
          {"field": "identity", "op": "contains", "value": "ios"},
          {"field": "identity", "op": "contains", "value": "ipados"}
        ]
      }
    },
    {
      "id": "browser",
      "role": "policy",
      "family": "Plex Web",
      "preset": "text",
      "notes": "Browser codec declarations govern playback; text subtitles remain sidecars.",
      "match": {
        "any": [
          {"field": "identity", "op": "contains", "value": "plex web"},
          {"field": "identity", "op": "contains", "value": "safari"},
          {"field": "identity", "op": "contains", "value": "chrome"},
          {"field": "identity", "op": "contains", "value": "firefox"},
          {"field": "identity", "op": "contains", "value": "edge"}
        ]
      }
    },
    {
      "id": "shield",
      "role": "policy",
      "family": "Android TV (Shield)",
      "preset": "image",
      "dolbyVisionProfiles": [5, 8],
      "match": {"field": "identity", "op": "contains", "value": "shield"}
    },
    {
      "id": "android",
      "role": "policy",
      "family": "Android / Google TV",
