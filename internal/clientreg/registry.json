    {
      "id": "htpc",
      "role": "playback",
      "preset": "htpc",
      "match": {
        "any": [
          {"field": "product", "op": "contains", "value": "htpc"},
          {"field": "product", "op": "contains", "value": "plex media player"},
          {"field": "product", "op": "contains", "value": "kodi"},
          {"field": "product", "op": "contains", "value": "infuse"}
        ]
      }
    },
    {
      "id": "smart-tv",
      "role": "playback",
      "preset": "smartTV",
      "match": {
        "any": [
          {"field": "product", "op": "contains", "value": "samsung"},
          {"field": "product", "op": "contains", "value": "lg"},
          {"field": "product", "op": "contains", "value": "vizio"},
