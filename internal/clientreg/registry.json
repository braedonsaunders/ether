    {
      "id": "fire-tv-4k-max",
      "role": "patch",
      "patchHeight": 2160,
      "patchHdr10": true,
      "match": {
        "all": [
          {
            "any": [
              {"field": "product", "op": "contains", "value": "android"},
              {
                "all": [
                  {"field": "platform", "op": "equals", "value": "android"},
                  {"field": "product", "op": "notContains", "value": "web"}
                ]
              }
            ]
          },
          {
            "any": [
              {"field": "device", "op": "equals", "value": "AFTKA"},
              {"field": "model", "op": "equals", "value": "AFTKA"},
              {"field": "device", "op": "equals", "value": "AFTKRT"},
              {"field": "model", "op": "equals", "value": "AFTKRT"}
            ]
          }
        ]
      }
    },
    {
      "id": "plex-appletv-hdr10-base",
      "role": "quirk",
      "quirks": ["plex-appletv-hdr10-base"],
      "match": {
        "all": [
          {"field": "product", "op": "contains", "value": "plex"},
          {
            "any": [
              {"field": "product", "op": "contains", "value": "apple tv"},
              {"field": "platform", "op": "equals", "value": "tvos"}
