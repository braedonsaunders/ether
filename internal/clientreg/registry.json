              {"field": "platform", "op": "equals", "value": "android"},
              {"field": "product", "op": "notContains", "value": "web"}
            ]
          }
        ]
      }
    },
    {
      "id": "android-mobile-ceiling",
      "role": "quirk",
      "quirks": ["android-mobile-ceiling"],
      "match": {
        "all": [
          {
            "any": [
              {"field": "product", "op": "contains", "value": "android"},
              {
                "all": [
                  {"field": "platform", "op": "equals", "value": "android"},
                  {"field": "product", "op": "notContains", "value": "web"}
                ]
              }
            ]
          },
          {"field": "product", "op": "notContains", "value": "tv"},
          {"field": "device", "op": "notContains", "value": "shield"},
          {"field": "device", "op": "notContains", "value": "tv"}
        ]
